# Moban FU Case Tracker — Environment Variables
# Copy this file to .env and fill in the values

# Database (Supabase or local PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres123@db:5432/moban

# WAHA (WhatsApp HTTP API)
WAHA_URL=http://waha:3000
WAHA_API_KEY=your-waha-api-key
WAHA_SESSION=default
WA_GROUP_ID=120363xxx@g.us

# OpenRouter (LLM fallback for message parsing)
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Backend API authentication
BACKEND_API_KEY=your-backend-api-key

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate limiting (requests per minute)
RATE_LIMIT_RPM=60

# PostgreSQL password (for docker-compose)
POSTGRES_PASSWORD=postgres123
