# Skrip & SQL HARUS LF di semua checkout/arsip: `git archive` pada Windows
# (core.autocrlf=true) menyuntik CRLF, dan skrip hasil ekstrak gagal di RHEL
# ("set: pipefail", "$'\r': command not found").
*.sh    text eol=lf
*.py    text eol=lf
*.sql   text eol=lf
*.service text eol=lf
*.conf  text eol=lf

# Linux-only, tidak boleh dikonversi
deploy/native/* text eol=lf
