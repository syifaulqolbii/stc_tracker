# IT Tracker — env produksi intranet itjatengdiypapp
# Salin ke /apps/www/it-tracker/.env lalu chmod 600.
# WAJIB kutip satu ('...') — ctl.sh memuat .env dengan `set -a; . .env`,
# jadi kutip ganda membuat shell mengekspansi $, backtick, ", dan \ di dalam
# password; DSN berubah tanpa error (terbukti diuji).
# Password berisi ' tidak bisa ditulis di sini: pakai percent-encoding di URI
# (mis. ' -> %27), atau ganti dulu password role-nya.

DATABASE_URL='postgresql://usernamedb:GANTI_PASSWORD@10.53.142.244:5432/namadb?options=-csearch_path%3Ddc_schema&connect_timeout=5&sslmode=prefer'

WAHA_URL=http://127.0.0.1:3000
WAHA_API_KEY=GANTI
WAHA_SESSION=default
WAHA_WEBHOOK_SECRET=GANTI
WA_GROUP_ID=

BACKEND_PUBLIC_URL=https://10.59.129.89/it-tracker
BACKEND_API_KEY=GANTI
ALLOWED_ORIGINS=https://GANTI-FE-VM
RATE_LIMIT_RPM=120

JWT_SECRET=GANTI
JWT_EXPIRY_HOURS=24
ACCESS_CODES=GANTI

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=-5326937435
HEALTH_ALERT_REMINDER_HOURS=6

OPENROUTER_API_KEY=
OPENROUTER_MODEL=WAHA
LLM_BASE_URL=

MEDIA_DIR=/apps/www/it-tracker/media
